# Copia questo file in `apps/web/.env.local`.
# ATTENZIONE: Next legge le variabili dalla cartella dell'app (apps/web),
# non dalla radice del monorepo. Alla radice non verrebbero lette.

# ---- Pubbliche: finiscono nel bundle del browser, protette da RLS ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...finto...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SOLO server: mai con prefisso NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...finto...
ANTHROPIC_API_KEY=sk-ant-finto
OPENAI_API_KEY=sk-finto

# ---- Test RLS (fase 0): stringa del Postgres locale di `supabase start` ----
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
